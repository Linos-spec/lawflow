# Database
DATABASE_URL="postgresql://user:password@localhost:5432/lawflow?schema=public"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"
# AUTH_SECRET is also accepted (NextAuth v5 convention)
# AUTH_SECRET="your-secret-key-here"

# OpenAI (for AI features)
OPENAI_API_KEY="your-openai-api-key"

# Environment
NODE_ENV="development"

# ── Outbound email (password reset). Optional; without it reset links are logged. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Linoscore Legal <no-reply@yourfirm.com>"
