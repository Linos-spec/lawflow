generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────

enum UserRole {
  ADMIN
  PARTNER
  ASSOCIATE
  PARALEGAL
}

enum CaseStatus {
  OPEN
  ACTIVE
  ON_HOLD
  PENDING
  CLOSED
  ARCHIVED
}

enum CaseType {
  CIVIL
  CRIMINAL
  FAMILY
  CORPORATE
  IMMIGRATION
  REAL_ESTATE
  BANKRUPTCY
  PERSONAL_INJURY
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ClientType {
  INDIVIDUAL
  BUSINESS_ENTITY
  GOVERNMENT
  NONPROFIT
  TRUST
  ESTATE
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  FORMER
  DECLINED
}

enum ContactMethod {
  EMAIL
  MOBILE_PHONE
  WORK_PHONE
  HOME_PHONE
  MAIL
  PORTAL
}

enum BillingArrangement {
  HOURLY
  FLAT_FEE
  CONTINGENCY
  RETAINER
  EVERGREEN_RETAINER
  PRO_BONO
  MIXED
}

enum BillingFrequency {
  MONTHLY
  QUARTERLY
  MILESTONE
  ON_COMPLETION
  ANNUAL
}

enum CollectionsStatus {
  CURRENT
  PAST_DUE
  IN_COLLECTIONS
  WRITTEN_OFF
}

enum RelationshipType {
  SPOUSE
  FORMER_SPOUSE
  PARTNER
  DEPENDENT
  CHILD
  PARENT
  GUARDIAN
  BUSINESS_PARTNER
  EMPLOYER
  RELATED_COMPANY
  SUBSIDIARY
  AFFILIATE
  PARENT_COMPANY
  TRUSTEE
  BENEFICIARY
  EXECUTOR
  POWER_OF_ATTORNEY
  AUTHORIZED_REPRESENTATIVE
  DECISION_MAKER
  EMERGENCY_CONTACT
  OTHER
}

enum DeadlineType {
  FILING
  COURT_APPEARANCE
  DISCOVERY
  STATUTE_OF_LIMITATIONS
  CLIENT_MEETING
  INTERNAL
  OTHER
}

enum DeadlineStatus {
  PENDING
  COMPLETED
  OVERDUE
  CANCELLED
}

enum BillingType {
  HOURLY
  FLAT_FEE
  CONTINGENCY
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OUTSTANDING
  OVERDUE
  VOID
}

enum IntakeStatus {
  PENDING
  IN_REVIEW
  CONVERTED
  REJECTED
  COMPLETED
}

enum LeadSource {
  PHONE
  WEBSITE
  REFERRAL
  GOOGLE
  WALK_IN
  OTHER
}

enum LeadStage {
  NEW
  QUALIFYING
  QUALIFIED
  CONSULT_SCHEDULED
  ENGAGED
  CONVERTED
  DISQUALIFIED
  LOST
}

enum ConflictStatus {
  PENDING
  CLEAR
  POTENTIAL
  CONFLICT
  WAIVED
}

enum DocumentType {
  CONTRACT
  PLEADING
  COURT_FILING
  CORRESPONDENCE
  EVIDENCE
  DISCOVERY
  INVOICE
  IDENTIFICATION
  ENGAGEMENT_LETTER
  MEMO
  OTHER
}

enum SignatureStatus {
  NOT_REQUIRED
  PENDING
  SIGNED
}

// ─── MULTI-TENANCY ─────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  firms Firm[]
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  hashedPassword String
  role           UserRole @default(ASSOCIATE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  firmId String?
  firm   Firm?   @relation(fields: [firmId], references: [id])

  timeEntries TimeEntry[]
  auditLogs   AuditLog[]
  responsibleForCases Case[] @relation("ResponsibleAttorney")

  @@index([organizationId])
  @@index([email])
}

model Firm {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  website   String?
  // Public identifier used for the unauthenticated intake link (/intake/[publicId]).
  // DB-level default so `prisma db push` backfills existing rows (no migration files here).
  publicId  String   @unique @default(dbgenerated("gen_random_uuid()::text"))
  // Opt-in "AI Employee" mode — a firm admin enables the AI pipeline workspace.
  aiModeEnabled Boolean @default(false)
  // Orchestrator setup (admin-configured): what the AI Employee does automatically.
  aiAutoCreateMatter     Boolean @default(true)  // convert a qualified lead → open the matter
  aiAutoGenerateTasks    Boolean @default(true)  // draft the initial deadline/task plan for a new matter
  aiAutoEngagementLetter Boolean @default(true)  // auto-draft an engagement letter when a matter opens

  // ── Linoscore Delivery connection (per-firm Customer account on the courier API) ──
  deliveryConnected    Boolean @default(false)
  deliveryApiEmail     String?  // firm's Linoscore Delivery login (server-side use only)
  deliveryApiPassword  String?  // stored to obtain JWTs from the Delivery API; never returned to the client
  deliveryCustomerId   String?  // cached customerId from the Delivery login
  deliveryPickupLine1  String?
  deliveryPickupLine2  String?
  deliveryPickupCity   String?
  deliveryPickupState  String?
  deliveryPickupPostal String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  users          User[]
  clients        Client[]
  cases          Case[]
  deadlines      Deadline[]
  billingRecords BillingRecord[]
  timeEntries    TimeEntry[]
  intakeForms    IntakeForm[]
  leads          Lead[]
  documents      Document[]
  deliveryRequests DeliveryRequest[]
  signatureRequests SignatureRequest[]
  relatedContacts RelatedContact[]

  @@index([organizationId])
}

// ─── BUSINESS ENTITIES ─────────────────────────────

model Client {
  id          String     @id @default(cuid())
  name        String     // primary / display name
  clientType  ClientType @default(INDIVIDUAL)
  status      ClientStatus @default(PROSPECT)

  // ── Identity (individual) ──
  legalName           String?
  preferredName       String?
  aliases             String[]  @default([]) // former names / aliases
  pronouns            String?
  dateOfBirth         DateTime?
  placeOfBirth        String?
  nationality         String?
  preferredLanguage   String?
  interpreterRequired Boolean   @default(false)
  photoUrl            String?   // photograph (individual) or logo (organization)

  // ── Identity (organization) ──
  company            String?  // legacy display org name
  legalBusinessName  String?
  dbaNames           String[] @default([]) // trading / DBA names
  entityType         String?               // LLC, C-Corp, LP, etc.
  formationState     String?
  formationCountry   String?
  formationDate      DateTime?
  registrationNumber String?               // registration / company number
  taxId              String?               // Tax ID / EIN
  registeredAgent    String?
  industry           String?
  website            String?
  parentCompany      String?

  // ── Contact information ──
  email          String? // primary email
  secondaryEmail String?
  phone          String? // legacy / primary phone
  mobilePhone    String?
  workPhone      String?
  homePhone      String?
  preferredContactMethod ContactMethod?
  bestTimeToContact      String?
  address         String?  // physical address
  mailingAddress  String?
  previousAddress String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  communicationRestrictions String?
  permitVoicemail Boolean @default(true)
  permitText      Boolean @default(true)
  permitEmail     Boolean @default(true)
  portalEnabled   Boolean @default(false)

  // ── Billing & payment ──
  billingContact        String?
  billingAddress        String?
  billingEmail          String?
  billingArrangement    BillingArrangement?
  hourlyRate            Decimal? @db.Decimal(12, 2)
  flatFee               Decimal? @db.Decimal(14, 2)
  contingencyPercent    Decimal? @db.Decimal(5, 2)
  retainerAmount        Decimal? @db.Decimal(14, 2)
  evergreenThreshold    Decimal? @db.Decimal(14, 2)
  trustBalance          Decimal  @default(0) @db.Decimal(14, 2)
  billingFrequency      BillingFrequency?
  invoiceDeliveryMethod String?
  paymentTerms          String?
  taxStatus             String?
  taxVatNumber          String?
  purchaseOrderNumber   String?
  ebillingSystem        String?
  billingGuidelines     String?
  discountPercent       Decimal? @db.Decimal(5, 2)
  feeCap                Decimal? @db.Decimal(14, 2)
  acceptedPaymentMethods String[] @default([])
  paymentPlanDetails    String?
  outstandingBalance    Decimal  @default(0) @db.Decimal(14, 2)
  creditBalance         Decimal  @default(0) @db.Decimal(14, 2)
  collectionsStatus     CollectionsStatus?
  // Tokenized references only — raw card/bank credentials are NEVER stored (PCI).
  paymentProviderCustomerId String?
  paymentMethodRef          String?

  notes       String?  // internal notes
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  firmId String
  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)

  cases          Case[]
  billingRecords BillingRecord[]
  intakeForms    IntakeForm[]
  documents      Document[]
  relatedContacts RelatedContact[] @relation("ClientRelatedContacts")
  linkedAsRelated RelatedContact[] @relation("RelatedClientLink")

  @@index([firmId])
  @@index([status])
}

// Relationship & household — each related person/entity is its own contact
// record linked to the client (not free text), optionally tied to another Client.
model RelatedContact {
  id               String           @id @default(cuid())
  relationshipType RelationshipType
  name             String
  email            String?
  phone            String?
  organization     String?
  address          String?
  isPrimaryDecisionMaker Boolean    @default(false)
  hasPowerOfAttorney     Boolean    @default(false)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  firmId String
  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation("ClientRelatedContacts", fields: [clientId], references: [id], onDelete: Cascade)

  // Optional link when the related party is itself a client of the firm.
  relatedClientId String?
  relatedClient   Client? @relation("RelatedClientLink", fields: [relatedClientId], references: [id], onDelete: SetNull)

  @@index([firmId])
  @@index([clientId])
  @@index([relatedClientId])
}

model Case {
  id          String     @id @default(cuid())
  caseNumber  String
  title       String
  description String?
  status      CaseStatus @default(OPEN)
  caseType    CaseType   @default(CIVIL)
  priority    Priority   @default(MEDIUM)
  filingDate  DateTime?
  openedDate  DateTime?
  closingDate DateTime?
  courtName   String?    // court or agency
  judgeName   String?
  notes       String?

  // ── Matter details ──
  practiceArea         String?
  matterSubtype        String?
  jurisdiction         String?
  venue                String?
  docketNumber         String?   // court's case/docket number (distinct from internal caseNumber)
  opposingParties      String[]  @default([])
  opposingCounsel      String?
  claimValue           Decimal?  @db.Decimal(19, 2) // claim or transaction value
  matterStage          String?
  nextAction           String?
  statuteOfLimitations DateTime?
  assignedTeamIds      String[]  @default([]) // User ids on the matter team
  customFields         Json?     // practice-area-specific custom fields

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  firmId String
  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  responsibleAttorneyId String?
  responsibleAttorney   User?   @relation("ResponsibleAttorney", fields: [responsibleAttorneyId], references: [id], onDelete: SetNull)

  // Cached AI Case Intelligence analysis (regenerated on demand).
  aiAnalysis   Json?
  aiAnalyzedAt DateTime?

  // Semantic-search embedding of the matter's facts (in-app cosine similarity).
  embedding    Float[]  @default([])
  embeddedAt   DateTime?

  deadlines      Deadline[]
  billingRecords BillingRecord[]
  timeEntries    TimeEntry[]
  documents      Document[]
  deliveryRequests DeliveryRequest[]

  @@unique([firmId, caseNumber])
  @@index([firmId])
  @@index([clientId])
  @@index([status])
}

model Deadline {
  id           String         @id @default(cuid())
  title        String
  description  String?
  dueDate      DateTime
  deadlineType DeadlineType   @default(OTHER)
  status       DeadlineStatus @default(PENDING)
  priority     Priority       @default(MEDIUM)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  firmId String
  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([caseId])
  @@index([dueDate])
  @@index([status])
}

model BillingRecord {
  id            String        @id @default(cuid())
  invoiceNumber String
  billingType   BillingType   @default(HOURLY)
  totalAmount   Decimal       @db.Decimal(19, 4)
  paidAmount    Decimal       @default(0) @db.Decimal(19, 4)
  paymentStatus PaymentStatus @default(UNPAID)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  firmId String
  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  lineItems BillingLineItem[]

  @@unique([firmId, invoiceNumber])
  @@index([firmId])
  @@index([clientId])
  @@index([caseId])
  @@index([paymentStatus])
}

model BillingLineItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @db.Decimal(10, 2)
  rate        Decimal @db.Decimal(19, 4)
  amount      Decimal @db.Decimal(19, 4)

  billingRecordId String
  billingRecord   BillingRecord @relation(fields: [billingRecordId], references: [id], onDelete: Cascade)

  @@index([billingRecordId])
}

model TimeEntry {
  id          String   @id @default(cuid())
  description String
  hours       Decimal  @db.Decimal(10, 2)
  rate        Decimal  @db.Decimal(19, 4)
  date        DateTime
  billable    Boolean  @default(true)
  billed      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  firmId String
  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([caseId])
  @@index([userId])
  @@index([date])
}

model IntakeForm {
  id                String       @id @default(cuid())
  prospectName      String
  prospectEmail     String?
  prospectPhone     String?
  caseType          CaseType     @default(OTHER)
  description       String?
  status            IntakeStatus @default(PENDING)
  conflictCheck     Boolean      @default(false)
  engagementLetter  Boolean      @default(false)
  idVerification    Boolean      @default(false)
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  firmId String
  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  @@index([firmId])
  @@index([status])
}

// ─── INTAKE PIPELINE (Phase 1: the intake brain) ────

model Lead {
  id            String     @id @default(cuid())
  // Contact
  name          String
  email         String?
  phone         String?
  // Funnel
  source        LeadSource @default(WEBSITE)
  stage         LeadStage  @default(NEW)
  caseType      CaseType   @default(OTHER)
  description   String?
  // Opposing / adverse parties captured during intake (for conflict checking)
  adverseParties String[]  @default([])
  // ── Minimum intake profile ──
  clientType             ClientType     @default(INDIVIDUAL)
  preferredName          String?
  preferredContactMethod ContactMethod?
  addressOrJurisdiction  String?
  referralSource         String?
  consultationPreference String?  // in-person, phone, video
  consentToContact       Boolean  @default(false)
  importantDates         String?  // key dates / deadlines mentioned at intake
  // Structured answers from the conversational questionnaire
  answers       Json?
  // AI qualification output
  qualified        Boolean?
  qualificationScore Int?          // 0-100
  aiPriority       Priority?
  aiSummary        String?
  aiRiskFlags      String[]  @default([])
  aiNextSteps      String[]  @default([])
  // AI retainer/fee recommendation (advisory — attorney sets final terms)
  retainerStructure  BillingType?
  retainerAmountLow  Int?
  retainerAmountHigh Int?
  retainerRationale  String?
  // Conflict check rollup (details in ConflictCheck)
  conflictStatus ConflictStatus @default(PENDING)
  // Follow-up
  nextFollowUpAt DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  firmId String
  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)

  // Set once the lead is converted into a client/case
  convertedClientId String?
  convertedCaseId   String?

  conflictChecks ConflictCheck[]

  @@index([firmId])
  @@index([stage])
  @@index([source])
  @@index([conflictStatus])
  @@index([createdAt])
}

model ConflictCheck {
  id         String         @id @default(cuid())
  status     ConflictStatus @default(PENDING)
  // Snapshot of what was searched
  searchedNames String[]    @default([])
  // Matches found: [{ type, id, name, matchedOn, score }]
  matches    Json           @default("[]")
  matchCount Int            @default(0)
  // Attorney review
  reviewed   Boolean        @default(false)
  reviewedBy String?
  reviewNote String?
  createdAt  DateTime       @default(now())

  firmId String

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([leadId])
  @@index([status])
}

// ─── DOCUMENT INTELLIGENCE (Phase D) ────────────────

model Document {
  id           String          @id @default(cuid())
  title        String
  originalName String
  documentType DocumentType    @default(OTHER)
  tags         String[]        @default([])
  // OCR / extracted text, used for full-text search.
  extractedText String?
  // AI organization output.
  aiSummary    String?
  aiParties    String[]        @default([])
  aiSuggestedTitle String?
  signatureStatus SignatureStatus @default(NOT_REQUIRED)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  firmId String
  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  uploadedBy String?

  versions        DocumentVersion[]
  signatureRequests SignatureRequest[]
  currentVersionId String?

  @@index([firmId])
  @@index([caseId])
  @@index([clientId])
  @@index([documentType])
  @@index([signatureStatus])
}

model DocumentVersion {
  id            String   @id @default(cuid())
  versionNumber Int
  fileName      String
  mimeType      String
  size          Int
  // Pluggable storage: DB-backed MVP stores bytes in `data`; a Spaces/S3
  // adapter would instead set `storageKey` and leave `data` null.
  data          Bytes?
  storageKey    String?
  uploadedBy    String?
  createdAt     DateTime @default(now())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([documentId])
}

// ─── LINOSCORE DELIVERY (courier module) ────────────

model DeliveryRequest {
  id             String   @id @default(cuid())
  // Identifiers from the Linoscore Delivery service
  externalId     String   // the Delivery API delivery id (Guid)
  trackingNumber String?
  status         String   @default("Requested") // mirrors the Delivery service status
  serviceLevel   String?
  priority       String?
  recipientName  String?
  reference      String?  // the matter number sent as the delivery reference
  isCourtFiling  Boolean  @default(false)
  dropoffSummary String?  // human-readable destination (e.g. court name / address)
  proofDocumentId String? // custody certificate pulled back as a Document once available
  lastSyncedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  firmId String
  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)

  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)

  documentId String? // the document being delivered / filed
  createdBy  String?

  @@unique([firmId, externalId])
  @@index([firmId])
  @@index([caseId])
  @@index([status])
}

// ─── E-SIGNATURE (built-in signer) ──────────────────

enum SignatureRequestStatus {
  PENDING
  SIGNED
  DECLINED
  VOID
}

model SignatureRequest {
  id            String                 @id @default(cuid())
  token         String                 @unique @default(cuid()) // public signing-link token
  status        SignatureRequestStatus @default(PENDING)
  signerName    String
  signerEmail   String?
  // Signature capture + ESIGN/UETA audit trail
  signatureData String?  // typed full name (rendered as the signature)
  signatureType String?  // "typed" | "drawn"
  consent       Boolean  @default(false)
  signedAt      DateTime?
  signerIp      String?
  signerUserAgent String?
  auditTrail    Json?    // append-only list of events (created/viewed/signed)
  expiresAt     DateTime?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  firmId String
  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([documentId])
  @@index([token])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  details   String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entity, entityId])
}
